# hdog-agent configuration. Copy to .env and edit. NEVER commit a real .env.
# Every value below is optional — the agent runs on its defaults with no env at all.

# ---------------------------------------------------------------- discovery ---
# fixture   replay the recorded tape in fixtures/ (default, deterministic)
# dexscreener  live read-only market data from the public DexScreener API
HDOG_SOURCE=fixture
HDOG_FIXTURE_PATH=fixtures/runners.sample.json
HDOG_DEXSCREENER_QUERY=dog
HDOG_MAX_UNIVERSE=40

# ----------------------------------------------------------------- strategy ---
HDOG_MIN_LIQUIDITY_USD=5000
HDOG_MAX_LIQUIDITY_USD=50000000
HDOG_MIN_VOLUME_RATIO=0.25
HDOG_MAX_VOLUME_RATIO=60
HDOG_MIN_AGE_HOURS=1
HDOG_MIN_MOMENTUM_PCT=3
HDOG_MIN_M5_PCT=0
HDOG_MAX_M5_PCT=60
HDOG_MIN_SCORE=45
HDOG_EXIT_SCORE=25

# --------------------------------------------------------------------- risk ---
HDOG_STARTING_CASH_USD=1000
HDOG_MAX_POSITIONS=5
HDOG_MAX_POSITION_PCT=0.2
HDOG_MIN_TRADE_USD=10
HDOG_STOP_LOSS_PCT=18
HDOG_TAKE_PROFIT_PCT=45
HDOG_TRAILING_STOP_PCT=22
HDOG_COOLDOWN_MINUTES=30

# ---------------------------------------------------------------- execution ---
# paper    price fills against the quote with a depth-aware slippage model
# devnet   same pricing, plus a real Solana devnet transaction per fill
HDOG_VENUE=paper
HDOG_FEE_BPS=30
HDOG_IMPACT_FACTOR=0.6
HDOG_MAX_SLIPPAGE_BPS=500

# ------------------------------------------------------- devnet settlement ---
# Only needed when HDOG_VENUE=devnet. A mainnet RPC here is refused by config.js.
# The keypair is a throwaway DEVNET key holding valueless test SOL. It is a file
# path, never a secret pasted into this file, and .gitignore keeps *.json keys out
# of the repository. This agent never asks for, imports or touches a real wallet.
HDOG_RPC_URL=https://api.devnet.solana.com
HDOG_KEYPAIR_PATH=
HDOG_SETTLEMENT_PUBKEY=
HDOG_SETTLEMENT_LAMPORTS=5000

# --------------------------------------------------------------------- loop ---
HDOG_TICKS=8
HDOG_TICK_SECONDS=3
HDOG_CLOCK_STEP_MINUTES=0
HDOG_JOURNAL_PATH=runs/journal.jsonl

# Set to 0 to strip ANSI colour from the output (useful when piping to a file).
HDOG_COLOR=1
